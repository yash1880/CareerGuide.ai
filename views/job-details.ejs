<%- include('partials/header') %>
    <%- include('partials/sidebar') %>
    <div class="sidebar-page-content">
    <main class="container-fluid py-4 px-4">
        <a href="/jobs" class="text-decoration-none small fw-semibold text-primary">
            <i class="ri-arrow-left-line me-1"></i>All jobs
        </a>

        <section class="card border-0 shadow-sm rounded-4 p-4 p-md-5 mt-3 mb-4 job-detail-hero">
            <div class="d-flex flex-wrap justify-content-between align-items-start gap-4">
                <div class="d-flex gap-3">
                    <div class="bg-primary-subtle text-primary rounded-4 d-flex align-items-center justify-content-center flex-shrink-0"
                         style="width:64px;height:64px">
                        <i class="ri-building-4-line fs-2"></i>
                    </div>
                    <div>
                        <span class="badge bg-primary-subtle text-primary mb-2"><%= job.type || 'Job' %></span>
                        <h1 class="h2 fw-bold text-dark mb-1"><%= job.title %></h1>
                        <div class="fs-5 fw-semibold text-primary"><%= job.company %></div>
                        <div class="small text-muted mt-2">
                            <% if (job.location) { %><span><i class="ri-map-pin-line me-1"></i><%= job.location %></span><% } %>
                            <% if (job.location && job.postedDate) { %><span class="mx-2">·</span><% } %>
                            <% if (job.postedDate) { %><span><i class="ri-time-line me-1"></i>Posted <%= job.postedDate %></span><% } %>
                        </div>
                    </div>
                </div>
                <a href="#applyCard" class="btn btn-primary rounded-pill px-4 fw-semibold">
                    Apply for this job <i class="ri-arrow-right-line ms-1"></i>
                </a>
            </div>
        </section>

        <div class="row g-4 align-items-start">
            <div class="col-lg-8">
                <section class="card border-0 shadow-sm rounded-4 p-4 p-md-5 mb-4">
                    <h2 class="h4 fw-bold text-dark mb-4">Job overview</h2>
                    <div class="row g-3">
                        <div class="col-sm-6">
                            <div class="border rounded-4 p-3 h-100">
                                <div class="small text-muted"><i class="ri-briefcase-3-line me-1"></i>Employment type</div>
                                <div class="fw-semibold text-dark mt-1"><%= job.type || 'Not specified' %></div>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="border rounded-4 p-3 h-100">
                                <div class="small text-muted"><i class="ri-map-pin-line me-1"></i>Location</div>
                                <div class="fw-semibold text-dark mt-1"><%= job.location || 'Not specified' %></div>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="border rounded-4 p-3 h-100">
                                <div class="small text-muted"><i class="ri-money-rupee-circle-line me-1"></i>Salary / stipend</div>
                                <div class="fw-semibold text-dark mt-1"><%= job.salary || 'Not specified by employer' %></div>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="border rounded-4 p-3 h-100">
                                <div class="small text-muted"><i class="ri-calendar-line me-1"></i>Posted</div>
                                <div class="fw-semibold text-dark mt-1"><%= job.postedDate || 'Date not provided' %></div>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="border rounded-4 p-3 h-100">
                                <div class="small text-muted"><i class="ri-bar-chart-box-line me-1"></i>Experience level</div>
                                <div class="fw-semibold text-dark mt-1"><%= job.experienceLevel || 'Not specified in the listing' %></div>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="border rounded-4 p-3 h-100">
                                <div class="small text-muted"><i class="ri-computer-line me-1"></i>Work mode</div>
                                <div class="fw-semibold text-dark mt-1"><%= job.workMode || 'Not specified in the listing' %></div>
                            </div>
                        </div>
                    </div>

                    <hr class="my-4">

                    <h2 class="h4 fw-bold text-dark mb-3">Role description</h2>
                    <% if (job.description) { %>
                        <div class="text-secondary" style="white-space: pre-line;line-height:1.8"><%= job.description %></div>
                    <% } else { %>
                        <p class="text-muted mb-0">The employer has not added a job description yet.</p>
                    <% } %>

                    <% if (Array.isArray(job.roleFocus) && job.roleFocus.length > 0) { %>
                        <div class="bg-light rounded-4 p-4 mt-4">
                            <h3 class="h6 fw-bold text-dark mb-2"><i class="ri-list-check-2 me-1 text-primary"></i>What this role may involve</h3>
                            <p class="small text-muted">A guide inferred from the role title and technologies in the listing, not a confirmed employer responsibility list.</p>
                            <ul class="text-secondary ps-3 mb-0" style="line-height:1.8">
                                <% job.roleFocus.forEach(item => { %>
                                    <li><%= item %></li>
                                <% }) %>
                            </ul>
                        </div>
                    <% } %>

                    <hr class="my-4">

                    <h2 class="h4 fw-bold text-dark mb-3">Requirements mentioned in the listing</h2>
                    <% if (Array.isArray(job.requirements) && job.requirements.length > 0) { %>
                        <ul class="text-secondary ps-3 mb-0" style="line-height:1.8">
                            <% job.requirements.forEach(requirement => { %>
                                <li><%= requirement %></li>
                            <% }) %>
                        </ul>
                    <% } else { %>
                        <% if (Array.isArray(job.detailSkills) && job.detailSkills.length > 0) { %>
                            <p class="small text-muted">These technologies and skills are named in the job title or description; they are not additional employer-confirmed eligibility criteria.</p>
                            <div class="d-flex flex-wrap gap-2">
                                <% job.detailSkills.forEach(skill => { %>
                                    <span class="badge rounded-pill bg-primary-subtle text-primary px-3 py-2"><%= skill %></span>
                                <% }) %>
                            </div>
                        <% } else { %>
                            <p class="text-muted mb-0">The employer has not provided separate job requirements for this listing.</p>
                        <% } %>
                    <% } %>

                    <div class="row g-3 mt-2">
                        <div class="col-md-6">
                            <div class="bg-light rounded-4 p-3 h-100">
                                <div class="small fw-semibold text-dark mb-1"><i class="ri-graduation-cap-line me-1 text-primary"></i>Education</div>
                                <div class="small text-muted">Not specified in the listing. Confirm directly with the employer.</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="bg-light rounded-4 p-3 h-100">
                                <div class="small fw-semibold text-dark mb-1"><i class="ri-user-star-line me-1 text-primary"></i>Experience</div>
                                <div class="small text-muted"><%= job.experienceLevel || 'Not specified in the listing' %>. Exact years of experience are not provided.</div>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="card border-0 shadow-sm rounded-4 p-4 p-md-5">
                    <h2 class="h4 fw-bold text-dark mb-3">About the employer</h2>
                    <div class="d-flex align-items-center gap-3">
                        <div class="bg-light text-primary rounded-3 d-flex align-items-center justify-content-center flex-shrink-0"
                             style="width:48px;height:48px">
                            <i class="ri-building-line fs-4"></i>
                        </div>
                        <div>
                            <h3 class="h6 fw-bold mb-1"><%= job.company %></h3>
                            <div class="small text-muted"><%= job.location || 'Location not specified' %></div>
                        </div>
                    </div>
                    <p class="small text-muted mt-3 mb-0">Company profile details, benefits, and hiring information were not included in this listing.</p>
                </section>
            </div>

            <aside class="col-lg-4">
                <section id="applyCard" class="card border-0 shadow-sm rounded-4 p-4 sticky-top" style="top:100px">
                    <h2 class="h5 fw-bold text-dark">Interested in this role?</h2>
                    <p class="small text-muted">Track this opportunity in My Applications, then continue to the employer’s application page if one is available.</p>
                    <button id="applyToJob" type="button" class="btn btn-primary rounded-pill w-100 fw-semibold"
                            data-job-id="<%= job._id %>" data-apply-link="<%= job.applyLink || '' %>">
                        Apply Now <i class="ri-arrow-right-up-line ms-1"></i>
                    </button>
                    <div id="applicationMessage" class="alert d-none mt-3 mb-0 small" role="status" aria-live="polite"></div>
                    <hr>
                    <div class="small text-muted d-flex justify-content-between gap-3">
                        <span>Position</span><span class="text-dark fw-semibold text-end"><%= job.title %></span>
                    </div>
                    <div class="small text-muted d-flex justify-content-between gap-3 mt-2">
                        <span>Company</span><span class="text-dark fw-semibold text-end"><%= job.company %></span>
                    </div>
                    <% if (!job.applyLink || job.applyLink === '#') { %>
                        <p class="small text-muted border-top pt-3 mt-3 mb-0">An external application link has not been provided. Your application will still be saved in your tracker.</p>
                    <% } %>
                </section>
            </aside>
        </div>
    </main>
    <%- include('partials/footer') %>
    </div>
    <script>
        const applyButton = document.getElementById('applyToJob');
        const applicationMessage = document.getElementById('applicationMessage');

        applyButton.addEventListener('click', async () => {
            applyButton.disabled = true;
            try {
                const response = await fetch('/applications/api/apply', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        jobOrInternshipId: applyButton.dataset.jobId,
                        type: 'Job'
                    })
                });
                const result = await response.json();
                applicationMessage.textContent = result.message || 'Unable to track this application.';
                applicationMessage.className = `alert ${response.ok || response.status === 409 ? 'alert-success' : 'alert-warning'} mt-3 mb-0 small`;
                applicationMessage.classList.remove('d-none');
                if (response.ok || response.status === 409) {
                    const applyLink = applyButton.dataset.applyLink;
                    if (applyLink && applyLink !== '#') {
                        if (/^(https?:\/\/|\/)/i.test(applyLink)) {
                            window.location.assign(new URL(applyLink, window.location.origin).href);
                        } else {
                            applyButton.textContent = 'Application tracked';
                        }
                    } else {
                        applyButton.textContent = 'Application tracked';
                    }
                }
            } catch (error) {
                applicationMessage.textContent = 'Could not reach the server. Please try again.';
                applicationMessage.className = 'alert alert-danger mt-3 mb-0 small';
                applicationMessage.classList.remove('d-none');
            } finally {
                applyButton.disabled = false;
            }
        });
    </script>
</body>
