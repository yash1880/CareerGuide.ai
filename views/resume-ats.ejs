<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>ATS Resume Checker - CareerGuide.ai</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/remixicon@3.5.0/fonts/remixicon.css" rel="stylesheet">
    <link href="/assets/css/style.css" rel="stylesheet">
</head>
<body class="bg-light">
    <%- include('partials/sidebar') %>
    <div class="sidebar-page-content">

    <main class="container-fluid py-4 px-4">
        <header class="app-page-heading mb-4">
            <span class="app-page-eyebrow">RESUME TOOLKIT</span>
            <h1><i class="ri-file-text-line me-2"></i>AI ATS Resume Checker</h1>
            <p class="mb-0">See how your resume matches a target role and identify useful improvements.</p>
        </header>

        <!-- Side-by-Side 2-Column Layout Container -->
        <div class="row g-4 align-items-start">
            
            <!-- Left Column: AI ATS Resume Checker Form Card -->
            <div class="col-lg-6">
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
                    <% if (error) { %>
                        <div class="alert alert-danger py-2 small" role="alert"><%= error %></div>
                    <% } %>

                    <form action="/resume-ats/scan" method="POST" enctype="multipart/form-data">
                        <div class="mb-3">
                            <label for="resume" class="form-label fw-semibold small text-secondary">Upload Resume (PDF or DOCX)</label>
                            <input class="form-control" type="file" id="resume" name="resume" accept=".pdf,.docx" required>
                        </div>

                        <div class="mb-4">
                            <label for="jobRole" class="form-label fw-semibold small text-secondary">Target Role / Field</label>
                            <select name="jobRole" id="jobRole" class="form-select" required>
                                <option value="MERN Stack Developer" <%= selectedJobRole === 'MERN Stack Developer' ? 'selected' : '' %>>MERN Stack Developer</option>
                                <option value="Python / Django / Flask Developer" <%= selectedJobRole === 'Python / Django / Flask Developer' ? 'selected' : '' %>>Python / Django / Flask Developer</option>
                                <option value="Frontend Developer (React/Vue)" <%= selectedJobRole === 'Frontend Developer (React/Vue)' ? 'selected' : '' %>>Frontend Developer (React/Vue)</option>
                                <option value="Data Science & Machine Learning" <%= selectedJobRole === 'Data Science & Machine Learning' ? 'selected' : '' %>>Data Science & Machine Learning</option>
                                <option value="Java / Spring Boot Developer" <%= selectedJobRole === 'Java / Spring Boot Developer' ? 'selected' : '' %>>Java / Spring Boot Developer</option>
                            </select>
                        </div>

                        <div class="mb-4">
                            <label for="jobDescription" class="form-label fw-semibold small text-secondary">Job Description (Optional)</label>
                            <textarea name="jobDescription" id="jobDescription" class="form-control" rows="8" placeholder="Paste the Job Description here (optional)"><%= jobDescription || '' %></textarea>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary py-2 rounded-pill fw-semibold shadow-sm">
                                <i class="ri-scan-line me-1"></i> Scan Resume with AI
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Right Column: Scan Results Card -->
            <div class="col-lg-6">
                <% if (typeof result !== 'undefined' && result) { %>
                    <% const foundKeywords = result.keywords && result.keywords.found ? result.keywords.found : result.matchedKeywords || []; %>
                    <% const missingKeywords = result.keywords && result.keywords.missing ? result.keywords.missing : result.missingKeywords || []; %>
                    <% const sectionLabels = { formatting: 'Formatting', contactInformation: 'Contact Information', summary: 'Professional Summary', skills: 'Skills', experience: 'Work Experience', education: 'Education', projects: 'Projects', certifications: 'Certifications' }; %>
                    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
                        <div class="d-flex align-items-center justify-content-between border-bottom pb-3 mb-3">
                            <div>
                                <h4 class="fw-bold text-dark mb-1">Scan Results</h4>
                                <p class="text-muted small mb-0">File: <span class="fw-semibold text-dark"><%= result.resumeFileName %></span></p>
                            </div>
                            <div>
                                <span class="badge bg-primary-subtle text-primary fs-5 px-3 py-2 rounded-pill fw-bold"><%= result.atsScore %>% Score</span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <h6 class="fw-bold text-dark mb-2">Overall Assessment</h6>
                            <p class="text-muted small mb-0"><%= result.summary || '' %></p>
                        </div>

                        <% if (result.sectionScores) { %>
                            <div class="mb-3">
                                <h6 class="fw-bold text-dark mb-2">Section Scores</h6>
                                <% Object.entries(result.sectionScores.toObject ? result.sectionScores.toObject() : result.sectionScores).forEach(([section, score]) => { %>
                                    <% if (sectionLabels[section] && Number.isFinite(score)) { %>
                                        <div class="mb-2">
                                            <div class="d-flex justify-content-between small text-muted mb-1">
                                                <span><%= sectionLabels[section] %></span>
                                                <span><%= score %>%</span>
                                            </div>
                                            <div class="progress" role="progressbar" aria-label="<%= sectionLabels[section] %> score" aria-valuenow="<%= score %>" aria-valuemin="0" aria-valuemax="100">
                                                <div class="progress-bar bg-primary" style="width: <%= score %>%"></div>
                                            </div>
                                        </div>
                                    <% } %>
                                <% }) %>
                            </div>
                        <% } %>

                        <% if (result.assessment) { %>
                            <div class="mb-3">
                                <h6 class="fw-bold text-dark mb-2">ATS and Resume Details</h6>
                                <ul class="text-muted small ps-3 mb-0">
                                    <li><span class="fw-semibold">Resume length:</span> <%= result.assessment.resumeLength %></li>
                                    <li><span class="fw-semibold">ATS compatibility:</span> <%= result.assessment.atsCompatibility %></li>
                                    <li><span class="fw-semibold">Action verbs:</span> <%= result.assessment.actionVerbs %></li>
                                    <li><span class="fw-semibold">Quantified achievements:</span> <%= result.assessment.quantifiedAchievements %></li>
                                    <li><span class="fw-semibold">Technical skills:</span> <%= result.assessment.technicalSkills %></li>
                                    <li><span class="fw-semibold">Skill match:</span> <%= result.assessment.skillMatch %></li>
                                    <li><span class="fw-semibold">Experience match:</span> <%= result.assessment.experienceMatch %></li>
                                </ul>
                            </div>
                        <% } %>

                        <div class="mb-3">
                            <h6 class="fw-bold text-success mb-2"><i class="ri-checkbox-circle-line me-1"></i> Keywords Found:</h6>
                            <div class="d-flex flex-wrap gap-1">
                                <% foundKeywords.forEach(kw => { %>
                                    <span class="badge bg-success-subtle text-success px-2.5 py-1"><%= kw %></span>
                                <% }) %>
                                <% if (!foundKeywords.length) { %><span class="text-muted small">No matching keywords identified.</span><% } %>
                            </div>
                        </div>

                        <div class="mb-3">
                            <h6 class="fw-bold text-danger mb-2"><i class="ri-close-circle-line me-1"></i> Missing Keywords:</h6>
                            <div class="d-flex flex-wrap gap-1">
                                <% missingKeywords.forEach(kw => { %>
                                    <span class="badge bg-danger-subtle text-danger px-2.5 py-1"><%= kw %></span>
                                <% }) %>
                                <% if (!missingKeywords.length) { %><span class="text-muted small">No specific missing keywords identified.</span><% } %>
                            </div>
                        </div>

                        <% if (result.strengths && result.strengths.length) { %>
                            <div class="mb-3">
                                <h6 class="fw-bold text-success mb-2">Strengths:</h6>
                                <ul class="text-muted small ps-3 mb-0">
                                    <% result.strengths.forEach(item => { %><li class="mb-1"><%= item %></li><% }) %>
                                </ul>
                            </div>
                        <% } %>

                        <% if (result.weaknesses && result.weaknesses.length) { %>
                            <div class="mb-3">
                                <h6 class="fw-bold text-danger mb-2">Weaknesses:</h6>
                                <ul class="text-muted small ps-3 mb-0">
                                    <% result.weaknesses.forEach(item => { %><li class="mb-1"><%= item %></li><% }) %>
                                </ul>
                            </div>
                        <% } %>

                        <% if (result.formattingIssues && result.formattingIssues.length) { %>
                            <div class="mb-3">
                                <h6 class="fw-bold text-dark mb-2">Formatting Issues:</h6>
                                <ul class="text-muted small ps-3 mb-0">
                                    <% result.formattingIssues.forEach(item => { %><li class="mb-1"><%= item %></li><% }) %>
                                </ul>
                            </div>
                        <% } %>

                        <% if (result.grammarIssues && result.grammarIssues.length) { %>
                            <div class="mb-3">
                                <h6 class="fw-bold text-dark mb-2">Grammar and Spelling:</h6>
                                <ul class="text-muted small ps-3 mb-0">
                                    <% result.grammarIssues.forEach(item => { %><li class="mb-1"><%= item %></li><% }) %>
                                </ul>
                            </div>
                        <% } %>

                        <% if (result.improvements && result.improvements.length) { %>
                            <div class="mb-3">
                                <h6 class="fw-bold text-dark mb-2">Improvements:</h6>
                                <ul class="text-muted small ps-3 mb-0">
                                    <% result.improvements.forEach(item => { %><li class="mb-1"><%= item %></li><% }) %>
                                </ul>
                            </div>
                        <% } %>

                        <div>
                            <h6 class="fw-bold text-dark mb-2"><i class="ri-lightbulb-line text-warning me-1"></i> Recommendations:</h6>
                            <ul class="text-muted small ps-3 mb-0">
                                <% (result.recommendations || []).forEach(rec => { %>
                                    <li class="mb-1"><%= rec %></li>
                                <% }) %>
                            </ul>
                        </div>
                    </div>
                <% } else { %>
                    <!-- Placeholder Card -->
                    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100 d-flex flex-column align-items-center justify-content-center text-center text-muted py-5">
                        <i class="ri-bar-chart-box-line display-4 text-secondary mb-3 opacity-50"></i>
                        <h5 class="fw-bold text-secondary">No Scan Results Yet</h5>
                        <p class="small mb-0">Upload your resume and click 'Scan Resume with AI' to view your compatibility score and keyword breakdown here.</p>
                    </div>
                <% } %>
            </div>

        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const scanForm = document.querySelector('form[action="/resume-ats/scan"]');
        if (scanForm) {
            scanForm.addEventListener('submit', () => {
                const scanButton = scanForm.querySelector('button[type="submit"]');
                scanButton.disabled = true;
                scanButton.innerHTML = 'Analyzing Resume...';
            });
        }
    </script>
    </div>
</body>
</html>