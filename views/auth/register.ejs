<%- include('../partials/header') %>

<div class="d-flex align-items-center justify-content-center min-vh-100 py-5" style="background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);">
    <div class="container" style="max-width: 440px;">
        <!-- Brand Logo on Top -->
        <div class="text-center mb-4">
            <a class="navbar-brand fw-bold d-inline-flex align-items-center gap-2 text-decoration-none" href="/">
                <div class="bg-primary text-white p-2 rounded-3 d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                    <i class="ri-robot-2-fill fs-5"></i>
                </div>
                <span class="fs-4 tracking-tight text-dark">CareerGuide<span class="text-primary">.ai</span></span>
            </a>
        </div>

        <div class="card border-0 shadow-lg rounded-4 p-4 p-md-5 bg-white">
            <div class="text-center mb-4">
                <h3 class="fw-bold text-dark mb-1">Create an Account</h3>
                <p class="text-muted small">Start your smart AI career journey today.</p>
            </div>

            <% if (typeof error !== 'undefined' && error) { %>
                <div class="alert alert-danger py-2 small mb-3 rounded-3 text-center" role="alert">
                    <%= error %>
                </div>
            <% } %>

            <form action="/auth/register" method="POST">
                <div class="mb-3">
                    <label for="name" class="form-label small fw-semibold text-dark">Full Name</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted"><i class="ri-user-line"></i></span>
                        <input type="text" class="form-control bg-light border-start-0 ps-0 shadow-none" id="name" name="name" placeholder="Enter your full name" autocomplete="off" required>
                    </div>
                </div>

                <div class="mb-3">
                    <label for="email" class="form-label small fw-semibold text-dark">Email Address</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted"><i class="ri-mail-line"></i></span>
                        <input type="email" class="form-control bg-light border-start-0 ps-0 shadow-none" id="email" name="email" placeholder="name@example.com" autocomplete="off" required>
                    </div>
                </div>

                <div class="mb-4">
                    <label for="password" class="form-label small fw-semibold text-dark">Password</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted"><i class="ri-lock-password-line"></i></span>
                        <input type="password" class="form-control bg-light border-start-0 ps-0 shadow-none" id="password" name="password" placeholder="••••••••" required>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-3 rounded-pill fw-semibold shadow-sm mb-3">
                    Create Free Account <i class="ri-arrow-right-line ms-1"></i>
                </button>
            </form>

            <div class="text-center mt-3">
                <p class="text-muted small mb-0">Already have an account? <a href="/auth/login" class="text-primary text-decoration-none fw-semibold">Log In</a></p>
            </div>
        </div>
    </div>
</div>