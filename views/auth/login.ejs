<%- include('../partials/header') %>

<div class="d-flex align-items-center justify-content-center vh-100" style="background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);">
    <div class="container" style="max-width: 420px;">
        <!-- Brand Logo on Top -->
        <div class="text-center mb-4">
            <a class="navbar-brand fw-bold d-inline-flex align-items-center gap-2 text-decoration-none" href="/">
                <div class="bg-primary text-white p-2 rounded-3 d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                    <i class="ri-robot-2-fill fs-5"></i>
                </div>
                <span class="fs-4 tracking-tight text-dark">CareerGuide<span class="text-primary">.ai</span></span>
            </a>
        </div>

        <div class="card border-0 shadow-lg rounded-4 p-4 p-md-5 bg-white">
            <div class="text-center mb-4">
                <h3 class="fw-bold text-dark mb-1">Welcome Back</h3>
                <p class="text-muted small">Please enter your details to sign in.</p>
            </div>

            <% if (typeof error !== 'undefined' && error) { %>
                <div class="alert alert-danger py-2 small mb-3 rounded-3 text-center" role="alert">
                    <%= error %>
                </div>
            <% } %>

            <% if (githubConfigured) { %>
                <a href="/auth/github" class="btn btn-outline-dark w-100 py-3 rounded-pill fw-semibold mb-3">
                    <i class="ri-github-fill me-2"></i>Continue with GitHub
                </a>
                <div class="d-flex align-items-center gap-3 mb-3">
                    <hr class="flex-grow-1 my-0">
                    <span class="small text-muted">or sign in with email</span>
                    <hr class="flex-grow-1 my-0">
                </div>
            <% } %>

            <form action="/auth/login" method="POST">
                <div class="mb-3">
                    <label for="email" class="form-label small fw-semibold text-dark">Email Address</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted"><i class="ri-mail-line"></i></span>
                        <input type="email" class="form-control bg-light border-start-0 ps-0 shadow-none" id="email" name="email" placeholder="name@example.com" required>
                    </div>
                </div>

                <div class="mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <label for="password" class="form-label small fw-semibold text-dark mb-0">Password</label>
                        <a href="#" class="small text-primary text-decoration-none">Forgot password?</a>
                    </div>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted"><i class="ri-lock-password-line"></i></span>
                        <input type="password" class="form-control bg-light border-start-0 ps-0 shadow-none" id="password" name="password" placeholder="••••••••" required>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-3 rounded-pill fw-semibold shadow-sm mb-3">
                    Log In <i class="ri-arrow-right-line ms-1"></i>
                </button>
            </form>

            <div class="text-center mt-3">
                <p class="text-muted small mb-0">Don't have an account? <a href="/auth/register" class="text-primary text-decoration-none fw-semibold">Sign Up</a></p>
            </div>
        </div>
     
    </div>
</div>
