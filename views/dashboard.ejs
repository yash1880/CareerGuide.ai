<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - CareerGuide.ai</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Remix Icons -->
    <link href="https://cdn.jsdelivr.net/npm/remixicon@3.5.0/fonts/remixicon.css" rel="stylesheet">
    <link rel="stylesheet" href="/assets/css/style.css">
</head>
<body class="bg-body-tertiary">
    <%- include('partials/sidebar') %>

    <!-- MAIN WORKSPACE AREA -->
    <div class="sidebar-page-content min-vh-100 p-4">
        <div class="container-fluid dashboard-content">

            <!-- Existing Welcome Header -->
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center bg-white p-4 rounded-4 shadow-sm mb-4 border gap-3">
                <div>
                    <h4 class="fw-bold text-dark mb-1">Welcome back, <%= (user && user.name) ? user.name : 'Developer' %>! 👋</h4>
                    <p class="text-muted small mb-0">Track your resume ATS score, career roadmaps, and active job applications.</p>
                </div>
                <div class="d-flex align-items-center flex-wrap gap-3">
                    <div class="bg-light px-3 py-2 rounded-pill border d-flex align-items-center gap-2">
                        <i class="ri-flashlight-fill text-warning"></i>
                        <span class="small fw-bold text-black">500 / 500 AI Credits</span>
                    </div>
                    <span class="badge bg-success-subtle text-success px-3 py-2 rounded-pill fw-semibold small border border-success border-opacity-25">
                        <i class="ri-checkbox-circle-fill me-1"></i> Pro Plan
                    </span>
                    <a href="/resume-ats" class="btn btn-primary px-4 py-2 rounded-pill fw-semibold small shadow-sm">
                        <i class="ri-sparkles-line me-1"></i> Run ATS Scan
                    </a>
                </div>
            </div>

            <!-- Existing Quick Actions -->
            <div class="row g-4 mb-4">
                <div class="col-md-4">
                    <a href="/jobs" class="card border-0 shadow-sm rounded-4 p-4 text-decoration-none bg-white h-100 tool-card">
                        <div class="d-flex align-items-center gap-3">
                            <div class="bg-primary bg-opacity-10 text-primary p-3 rounded-3 fs-4">
                                <i class="ri-briefcase-4-line"></i>
                            </div>
                            <div>
                                <h5 class="fw-bold text-dark mb-1">Explore Jobs</h5>
                                <p class="text-muted small mb-0">Browse latest tech openings</p>
                            </div>
                        </div>
                    </a>
                </div>

                <div class="col-md-4">
                    <a href="/internships" class="card border-0 shadow-sm rounded-4 p-4 text-decoration-none bg-white h-100 tool-card">
                        <div class="d-flex align-items-center gap-3">
                            <div class="bg-success bg-opacity-10 text-success p-3 rounded-3 fs-4">
                                <i class="ri-graduation-cap-line"></i>
                            </div>
                            <div>
                                <h5 class="fw-bold text-dark mb-1">Internships</h5>
                                <p class="text-muted small mb-0">Find startup & remote roles</p>
                            </div>
                        </div>
                    </a>
                </div>

                <div class="col-md-4">
                    <a href="/resume-ats" class="card border-0 shadow-sm rounded-4 p-4 text-decoration-none bg-white h-100 tool-card">
                        <div class="d-flex align-items-center gap-3">
                            <div class="bg-warning bg-opacity-10 text-warning p-3 rounded-3 fs-4">
                                <i class="ri-file-text-line"></i>
                            </div>
                            <div>
                                <h5 class="fw-bold text-dark mb-1">ATS Checker</h5>
                                <p class="text-muted small mb-0">Scan your resume score</p>
                            </div>
                        </div>
                    </a>
                </div>
            </div>

            <!-- Existing Statistics -->
            <div class="row g-4 mb-4">
                <div class="col-xl-3 col-sm-6">
                    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="text-muted small fw-semibold text-uppercase tracking-wider">ATS Resume Score</span>
                            <div class="bg-primary-subtle text-primary p-2.5 rounded-3"><i class="ri-file-chart-line fs-5"></i></div>
                        </div>
                        <h3 class="fw-bold text-dark mb-0"><%= (user && user.atsScore !== undefined && user.atsScore !== null) ? user.atsScore : 0 %>%</h3>
                        <p class="text-muted x-small mb-0 mt-1">Upload resume to calculate score</p>
                    </div>
                </div>

                <div class="col-xl-3 col-sm-6">
                    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="text-muted small fw-semibold text-uppercase tracking-wider">Active Applications</span>
                            <div class="bg-warning-subtle text-warning p-2.5 rounded-3"><i class="ri-briefcase-4-line fs-5"></i></div>
                        </div>
                        <h3 class="fw-bold text-dark mb-0"><%= (applications && applications.length !== undefined) ? applications.length : 0 %></h3>
                        <p class="text-muted x-small mb-0 mt-1">Track your job pipeline</p>
                    </div>
                </div>

                <div class="col-xl-3 col-sm-6">
                    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="text-muted small fw-semibold text-uppercase tracking-wider">AI Mock Practice</span>
                            <div class="bg-success-subtle text-success p-2.5 rounded-3"><i class="ri-robot-2-line fs-5"></i></div>
                        </div>
                        <h3 class="fw-bold text-dark mb-0"><%= (user && user.mockScore !== undefined && user.mockScore !== null) ? user.mockScore : '0.0' %>/10</h3>
                        <p class="text-muted x-small mb-0 mt-1">Take your first mock test</p>
                    </div>
                </div>

               <div class="col-xl-3 col-sm-6">
                    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="text-muted small fw-semibold text-uppercase tracking-wider">Roadmap Progress</span>
                            <div class="bg-info-subtle text-info p-2.5 rounded-3"><i class="ri-road-map-line fs-5"></i></div>
                        </div>
                        <h3 class="fw-bold text-dark mb-0"><%= (user && user.roadmapProgress !== undefined && user.roadmapProgress !== null) ? user.roadmapProgress : 0 %>%</h3>
                        <div class="progress mt-2 w-100 rounded-pill" style="height: 5px;">
                            <div class="progress-bar bg-info rounded-pill" style="width: <%= (user && user.roadmapProgress !== undefined && user.roadmapProgress !== null) ? user.roadmapProgress : 0 %>%"></div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 1. CAREER READINESS SCORE -->
            <div class="row g-4 mb-4">
                <div class="col-12">
                    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 class="fw-bold text-dark mb-0"><i class="ri-shield-star-line text-primary me-2"></i> Career Readiness</h5>
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge bg-success-subtle text-success px-3 py-2 rounded-pill fw-semibold">On Track</span>
                                <a href="/skills" class="text-decoration-none small fw-semibold text-primary">View Full Report</a>
                            </div>
                        </div>
                        <div class="row align-items-center g-4">
                            <div class="col-md-3 text-center border-end">
                                <div class="rounded-circle bg-primary bg-opacity-10 d-flex flex-column align-items-center justify-content-center mx-auto" style="width: 110px; height: 110px;">
                                    <h3 class="fw-bold text-primary mb-0">82%</h3>
                                    <span class="text-muted" style="font-size: 10px;">Overall Score</span>
                                </div>
                            </div>
                            <div class="col-md-9">
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <div class="mb-2">
                                            <div class="d-flex justify-content-between small fw-semibold mb-1"><span>Profile Readiness</span><span class="text-success">90%</span></div>
                                            <div class="progress rounded-pill" style="height: 6px;"><div class="progress-bar bg-success rounded-pill" style="width: 90%;"></div></div>
                                        </div>
                                        <div>
                                            <div class="d-flex justify-content-between small fw-semibold mb-1"><span>Skill Readiness</span><span class="text-primary">85%</span></div>
                                            <div class="progress rounded-pill" style="height: 6px;"><div class="progress-bar bg-primary rounded-pill" style="width: 85%;"></div></div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="mb-2">
                                            <div class="d-flex justify-content-between small fw-semibold mb-1"><span>Resume Readiness</span><span class="text-warning">75%</span></div>
                                            <div class="progress rounded-pill" style="height: 6px;"><div class="progress-bar bg-warning rounded-pill" style="width: 75%;"></div></div>
                                        </div>
                                        <div>
                                            <div class="d-flex justify-content-between small fw-semibold mb-1"><span>Interview & Project</span><span class="text-info">80%</span></div>
                                            <div class="progress rounded-pill" style="height: 6px;"><div class="progress-bar bg-info rounded-pill" style="width: 80%;"></div></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 2. YOUR CAREER MATCH -->
            <div class="row g-4 mb-4">
                <div class="col-12">
                    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 class="fw-bold text-dark mb-0"><i class="ri-user-star-line text-success me-2"></i> Your Career Match</h5>
                            <span class="text-muted small">Personalized based on MERN Stack skills</span>
                        </div>
                        <div class="row g-3">
                            <div class="col-md-4 col-lg-2">
                                <div class="p-3 border rounded-4 bg-light h-100 d-flex flex-column justify-content-between">
                                    <div>
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <h6 class="fw-bold text-dark small mb-0">Frontend Dev</h6>
                                            <span class="badge bg-success text-white x-small">92%</span>
                                        </div>
                                        <p class="text-muted x-small mb-2">Strong match for React, JavaScript & Tailwind.</p>
                                        <div class="x-small text-muted mb-3">Skills: React, JS, CSS</div>
                                    </div>
                                    <a href="/jobs" class="btn btn-sm btn-outline-primary rounded-pill fw-semibold w-100 x-small">View Career</a>
                                </div>
                            </div>
                            <div class="col-md-4 col-lg-2">
                                <div class="p-3 border rounded-4 bg-light h-100 d-flex flex-column justify-content-between">
                                    <div>
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <h6 class="fw-bold text-dark small mb-0">Full Stack Dev</h6>
                                            <span class="badge bg-success text-white x-small">87%</span>
                                        </div>
                                        <p class="text-muted x-small mb-2">Matches Node.js, Express & MongoDB backend setup.</p>
                                        <div class="x-small text-muted mb-3">Skills: MERN, REST APIs</div>
                                    </div>
                                    <a href="/jobs" class="btn btn-sm btn-outline-primary rounded-pill fw-semibold w-100 x-small">View Career</a>
                                </div>
                            </div>
                            <div class="col-md-4 col-lg-2">
                                <div class="p-3 border rounded-4 bg-light h-100 d-flex flex-column justify-content-between">
                                    <div>
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <h6 class="fw-bold text-dark small mb-0">Backend Dev</h6>
                                            <span class="badge bg-primary text-white x-small">81%</span>
                                        </div>
                                        <p class="text-muted x-small mb-2">Fits server-side routing & database schema tasks.</p>
                                        <div class="x-small text-muted mb-3">Skills: Node.js, Mongo</div>
                                    </div>
                                    <a href="/jobs" class="btn btn-sm btn-outline-primary rounded-pill fw-semibold w-100 x-small">View Career</a>
                                </div>
                            </div>
                            <div class="col-md-4 col-lg-2">
                                <div class="p-3 border rounded-4 bg-light h-100 d-flex flex-column justify-content-between">
                                    <div>
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <h6 class="fw-bold text-dark small mb-0">UI/UX Designer</h6>
                                            <span class="badge bg-warning text-dark x-small">74%</span>
                                        </div>
                                        <p class="text-muted x-small mb-2">Based on responsive interface & template layout work.</p>
                                        <div class="x-small text-muted mb-3">Skills: Bootstrap, CSS</div>
                                    </div>
                                    <a href="/jobs" class="btn btn-sm btn-outline-primary rounded-pill fw-semibold w-100 x-small">View Career</a>
                                </div>
                            </div>
                            <div class="col-md-4 col-lg-2">
                                <div class="p-3 border rounded-4 bg-light h-100 d-flex flex-column justify-content-between">
                                    <div>
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <h6 class="fw-bold text-dark small mb-0">Data Analyst</h6>
                                            <span class="badge bg-secondary text-white x-small">65%</span>
                                        </div>
                                        <p class="text-muted x-small mb-2">Foundational analytics and query understanding.</p>
                                        <div class="x-small text-muted mb-3">Skills: SQL, Queries</div>
                                    </div>
                                    <a href="/jobs" class="btn btn-sm btn-outline-primary rounded-pill fw-semibold w-100 x-small">View Career</a>
                                </div>
                            </div>
                            <div class="col-md-4 col-lg-2">
                                <div class="p-3 border rounded-4 bg-light h-100 d-flex flex-column justify-content-between">
                                    <div>
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <h6 class="fw-bold text-dark small mb-0">DevOps Engineer</h6>
                                            <span class="badge bg-secondary text-white x-small">60%</span>
                                        </div>
                                        <p class="text-muted x-small mb-2">Basic GitHub version control and deployment knowledge.</p>
                                        <div class="x-small text-muted mb-3">Skills: Git, GitHub</div>
                                    </div>
                                    <a href="/jobs" class="btn btn-sm btn-outline-primary rounded-pill fw-semibold w-100 x-small">View Career</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 3. CAREER JOURNEY -->
            <div class="row g-4 mb-4">
                <div class="col-12">
                    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                        <h5 class="fw-bold text-dark mb-3"><i class="ri-road-map-line text-warning me-2"></i> Career Journey Progress</h5>
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 text-center overflow-x-auto py-2">
                            <div class="px-3 py-2 bg-success text-white rounded-3 small fw-semibold flex-grow-1">1. Profile <br><span class="x-small fw-normal">Completed</span></div>
                            <i class="ri-arrow-right-s-line text-muted fs-5"></i>
                            <div class="px-3 py-2 bg-success text-white rounded-3 small fw-semibold flex-grow-1">2. Assessment <br><span class="x-small fw-normal">Completed</span></div>
                            <i class="ri-arrow-right-s-line text-muted fs-5"></i>
                            <div class="px-3 py-2 bg-success text-white rounded-3 small fw-semibold flex-grow-1">3. Career Match <br><span class="x-small fw-normal">Completed</span></div>
                            <i class="ri-arrow-right-s-line text-muted fs-5"></i>
                            <div class="px-3 py-2 bg-primary text-white rounded-3 small fw-semibold flex-grow-1">4. Skill Gap <br><span class="x-small fw-normal">Current</span></div>
                            <i class="ri-arrow-right-s-line text-muted fs-5"></i>
                            <div class="px-3 py-2 bg-light text-dark border rounded-3 small fw-semibold flex-grow-1">5. Roadmap <br><span class="x-small text-muted fw-normal">Upcoming</span></div>
                            <i class="ri-arrow-right-s-line text-muted fs-5"></i>
                            <div class="px-3 py-2 bg-light text-dark border rounded-3 small fw-semibold flex-grow-1">6. Resume <br><span class="x-small text-muted fw-normal">Upcoming</span></div>
                            <i class="ri-arrow-right-s-line text-muted fs-5"></i>
                            <div class="px-3 py-2 bg-light text-dark border rounded-3 small fw-semibold flex-grow-1">7. Mock Interview <br><span class="x-small text-muted fw-normal">Upcoming</span></div>
                            <i class="ri-arrow-right-s-line text-muted fs-5"></i>
                            <div class="px-3 py-2 bg-light text-dark border rounded-3 small fw-semibold flex-grow-1">8. Job Application <br><span class="x-small text-muted fw-normal">Upcoming</span></div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 4 & 5. NEXT BEST ACTION + WHAT SHOULD I DO TODAY? -->
            <div class="row g-4 mb-4">
                <!-- 5. Next Best Action -->
                <div class="col-lg-5">
                    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100 border-start border-success border-4">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="badge bg-success-subtle text-success fw-semibold px-2.5 py-1 rounded-pill">
                                <i class="ri-lightbulb-flash-line me-1"></i> Recommended Next Step
                            </span>
                        </div>
                        <h5 class="fw-bold text-dark mb-2">Improve your React skills before applying for Frontend internships.</h5>
                        <p class="text-muted small mb-3">Our AI analyzer detected a small gap in advanced state management concepts (Redux Toolkit).</p>
                        <div class="bg-light p-3 rounded-3 mb-3 x-small text-muted">
                            <strong>Expected Benefit:</strong> Boosts your match rate from 92% to 98% for tier-1 tech companies.
                        </div>
                        <a href="/roadmap" class="btn btn-sm btn-success rounded-pill px-4 fw-semibold w-100">Start Recommended Task</a>
                    </div>
                </div>

                <!-- 4. What Should I Do Today? -->
                <div class="col-lg-7">
                    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 class="fw-bold text-dark mb-0"><i class="ri-calendar-check-line text-primary me-2"></i> What Should I Do Today?</h5>
                            <span class="badge bg-primary-subtle text-primary">Est. 45 mins</span>
                        </div>
                        <div class="d-flex flex-column gap-3 mb-3">
                            <div class="d-flex align-items-center justify-content-between p-2 rounded-3 bg-light">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="ri-checkbox-circle-fill text-success fs-5"></i>
                                    <span class="small fw-semibold text-dark text-decoration-line-through">Complete React assessment</span>
                                </div>
                                <span class="badge bg-success-subtle text-success x-small">Done</span>
                            </div>
                            <div class="d-flex align-items-center justify-content-between p-2 rounded-3 bg-light">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="ri-arrow-right-circle-line text-primary fs-5"></i>
                                    <span class="small fw-semibold text-dark">Improve GitHub README documentation</span>
                                </div>
                                <span class="badge bg-primary-subtle text-primary x-small">15m</span>
                            </div>
                            <div class="d-flex align-items-center justify-content-between p-2 rounded-3 bg-light">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="ri-checkbox-blank-circle-line text-muted fs-5"></i>
                                    <span class="small fw-semibold text-dark">Apply to 2 matching internships</span>
                                </div>
                                <span class="badge bg-secondary-subtle text-secondary x-small">20m</span>
                            </div>
                            <div class="d-flex align-items-center justify-content-between p-2 rounded-3 bg-light">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="ri-checkbox-blank-circle-line text-muted fs-5"></i>
                                    <span class="small fw-semibold text-dark">Practice 5 interview questions</span>
                                </div>
                                <span class="badge bg-secondary-subtle text-secondary x-small">10m</span>
                            </div>
                        </div>
                        <a href="/roadmap" class="btn btn-sm btn-primary rounded-pill px-4 fw-semibold w-100">Start Next Task</a>
                    </div>
                </div>
            </div>

            <!-- 6 & 7. SKILL GROWTH + CAREER MOMENTUM -->
            <div class="row g-4 mb-4">
                <!-- 6. Skill Growth -->
                <div class="col-lg-6">
                    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 class="fw-bold text-dark mb-0"><i class="ri-line-chart-line text-info me-2"></i> Skill Growth</h5>
                            <span class="badge bg-info-subtle text-info">Compared to Last Month</span>
                        </div>
                        <div class="d-flex flex-column gap-3">
                            <div>
                                <div class="d-flex justify-content-between small fw-semibold mb-1">
                                    <span>JavaScript</span>
                                    <span class="text-success fw-bold">↑ 12%</span>
                                </div>
                                <div class="progress rounded-pill" style="height: 6px;"><div class="progress-bar bg-success rounded-pill" style="width: 82%;"></div></div>
                            </div>
                            <div>
                                <div class="d-flex justify-content-between small fw-semibold mb-1">
                                    <span>React</span>
                                    <span class="text-success fw-bold">↑ 18%</span>
                                </div>
                                <div class="progress rounded-pill" style="height: 6px;"><div class="progress-bar bg-success rounded-pill" style="width: 88%;"></div></div>
                            </div>
                            <div>
                                <div class="d-flex justify-content-between small fw-semibold mb-1">
                                    <span>Node.js</span>
                                    <span class="text-success fw-bold">↑ 15%</span>
                                </div>
                                <div class="progress rounded-pill" style="height: 6px;"><div class="progress-bar bg-success rounded-pill" style="width: 78%;"></div></div>
                            </div>
                            <div>
                                <div class="d-flex justify-content-between small fw-semibold mb-1">
                                    <span>Git</span>
                                    <span class="text-success fw-bold">↑ 8%</span>
                                </div>
                                <div class="progress rounded-pill" style="height: 6px;"><div class="progress-bar bg-success rounded-pill" style="width: 70%;"></div></div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 7. Career Momentum -->
                <div class="col-lg-6">
                    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 class="fw-bold text-dark mb-0"><i class="ri-fire-line text-warning me-2"></i> Career Momentum</h5>
                            <span class="badge bg-warning-subtle text-dark fw-semibold">🔥 Strong Progress</span>
                        </div>
                        <p class="text-muted small mb-3">Your consistency metrics over the past 30 days:</p>
                        <div class="row g-3">
