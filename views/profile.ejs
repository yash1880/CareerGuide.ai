<%- include('partials/header') %>
<%- include('partials/sidebar') %>

<div class="sidebar-page-content bg-body-tertiary min-vh-100 p-4">
    <div class="container-fluid px-4" style="max-width: 1100px;">

        <header class="app-page-heading profile-page-heading">
            <span class="profile-heading-icon"><i class="ri-user-settings-line"></i></span>
            <div>
                <span class="app-page-eyebrow">YOUR ACCOUNT</span>
                <h1>Profile settings</h1>
                <p>Keep your personal details and career goals up to date.</p>
            </div>
        </header>

        <div class="card border-0 shadow-sm rounded-4 bg-white mb-4">
            <div class="card-body py-3 px-4">
                <div
                    class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                    <div
                        class="d-flex align-items-center gap-4 overflow-auto pb-2 pb-md-0">
                        <a href="#personalInformation"
                            class="text-decoration-none fw-semibold text-primary pb-1 border-bottom border-primary border-2">
                            <i class="ri-user-line me-1"></i> Profile Info
                        </a>
                        <a href="#careerGoals"
                            class="text-decoration-none text-muted pb-1">
                            <i class="ri-briefcase-line me-1"></i> Career Goals
                        </a>
                        <a href="#accountInformation"
                            class="text-decoration-none text-muted pb-1">
                            <i class="ri-shield-user-line me-1"></i> Account
                        </a>
                    </div>
                    <div class="text-muted small">
                        Profile completion:
                        <strong class="text-primary"><%= profileCompletion %>%</strong>
                        <div class="progress mt-2" style="height: 6px; width: 150px;" role="progressbar"
                             aria-label="Profile completion" aria-valuenow="<%= profileCompletion %>" aria-valuemin="0" aria-valuemax="100">
                            <div class="progress-bar" style="width: <%= profileCompletion %>%"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <form action="/users/profile/update" method="POST"
            enctype="multipart/form-data">
            <div class="row g-4">

                <!-- Left Side: Profile Summary Card with Photo Upload -->
                <div class="col-lg-4">
                    <div
                        class="card border-0 shadow-sm rounded-4 bg-white text-center p-4">
                        <div
                            class="position-relative d-inline-block mx-auto mb-3">

                            <!-- Display Profile Image or Initial Fallback -->
                            <% if (user.profileImage) { %>
                            <img src="<%= user.profileImage %>" alt="Profile"
                                class="rounded-circle shadow-sm object-fit-cover"
                                style="width: 100px; height: 100px;">
                            <% } else { %>
                            <div
                                class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold display-6 shadow-sm mx-auto"
                                style="width: 100px; height: 100px;">
                                <%= user.name ?
                                user.name.charAt(0).toUpperCase() : 'U' %>
                            </div>
                            <% } %>

                            <!-- Camera Icon Clickable to Upload Photo -->
                            <label for="profileImageInput"
                                class="profile-photo-upload position-absolute bottom-0 end-0 bg-white p-2 rounded-circle shadow-sm text-primary border"
                                style="cursor: pointer;"
                                title="Upload New Profile Picture">
                                <i class="ri-camera-line fs-6"></i>
                            </label>
                            <input type="file" id="profileImageInput"
                                name="profileImage" class="d-none"
                                accept="image/*">
                        </div>

                        <h5 class="fw-bold text-dark mb-1"><%= user.name %></h5>
                        <p class="text-primary small fw-semibold mb-2"><%=
                        user.targetRole || 'Add your target role'
                        %></p>

                        <% if (user.githubLink) { %>
                        <div class="mb-3">
                        <a
                            href="<%= user.githubLink %>"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="text-decoration-none text-muted small d-inline-flex align-items-center gap-1 bg-light px-3 py-1 rounded-pill border">
                            <i class="ri-github-fill text-dark fs-6"></i>
                            <span>View GitHub profile</span>
                        </a>
                        </div>
                        <% } %>

                        <div class="border-top pt-3 text-start">
                            <div
                                class="d-flex justify-content-between small mb-2">
                                <span class="text-muted">Member Since:</span>
                                <span class="fw-semibold text-dark">
                                    <%= user.createdAt ? new
                                    Date(user.createdAt).toLocaleDateString() :
                                    'Not available' %>
                                </span>
                            </div>
                            <div class="d-flex justify-content-between small">
                                <span class="text-muted">AI Credits:</span>
                                <span class="fw-semibold text-success"><%= user.aiCredits ?? 0 %> Credits</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Right Side: Detailed Edit Form Card -->
                <div class="col-lg-8">
                    <div
                        class="card border-0 shadow-sm rounded-4 bg-white p-4 p-md-4">
                        <h5 id="personalInformation" class="fw-bold text-dark mb-4"><i
                                class="ri-settings-3-line text-primary me-2"></i>
                            Personal Information</h5>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label for="profileName"
                                    class="form-label small fw-semibold text-dark">Full
                                    Name</label>
                                <input id="profileName" type="text" maxlength="100"
                                    class="form-control bg-light border-0 py-2.5 shadow-none"
                                    name="name" value="<%= user.name %>"
                                    required>
                            </div>
                            <div class="col-md-6">
                                <label for="targetRole"
                                    class="form-label small fw-semibold text-dark">Target
                                    Role</label>
                                <input id="targetRole" type="text" maxlength="100"
                                    class="form-control bg-light border-0 py-2.5 shadow-none"
                                    name="targetRole"
                                    value="<%= user.targetRole || '' %>"
                                    placeholder="e.g. Full Stack MERN Developer">
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label for="accountEmail"
                                    class="form-label small fw-semibold text-dark">Email
                                    Address</label>
                                <input id="accountEmail" type="email"
                                    class="form-control bg-light border-0 py-2.5 shadow-none"
                                    value="<%= user.email %>" disabled>
                                <div class="form-text text-muted"
                                    style="font-size: 11px;">Email cannot be
                                    changed directly.</div>
                            </div>
                            <div class="col-md-6">
                                <label for="githubLink"
                                    class="form-label small fw-semibold text-dark">GitHub
                                    Profile Link or Username</label>
                                <input id="githubLink" type="text" maxlength="255"
                                    class="form-control bg-light border-0 py-2.5 shadow-none"
                                    name="githubLink"
                                    value="<%= user.githubLink || '' %>"
                                    placeholder="https://github.com/yash1880">
                            </div>
                        </div>

                        <h6 id="careerGoals" class="fw-bold text-dark border-top pt-4 mt-4 mb-3">
                            <i class="ri-briefcase-line text-primary me-2"></i>Career preferences
                        </h6>
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label for="country"
                                    class="form-label small fw-semibold text-dark">Country</label>
                                <input id="country" type="text" maxlength="100"
                                    class="form-control bg-light border-0 py-2.5 shadow-none"
                                    name="country"
                                    value="<%= user.country || 'India' %>">
                            </div>
                            <div class="col-md-6">
                                <label for="language"
                                    class="form-label small fw-semibold text-dark">Primary
                                    Language</label>
                                <input id="language" type="text" maxlength="100"
                                    class="form-control bg-light border-0 py-2.5 shadow-none"
                                    name="language"
                                    value="<%= user.language || 'English' %>">
                            </div>
                        </div>

                        <div id="accountInformation" class="small text-muted border-top pt-3 mb-3">
                            <i class="ri-lock-line me-1"></i>
                            Your email is used to sign in and cannot be changed from this page.
                            Password changes are managed separately from profile details.
                        </div>

                        <!-- Action Buttons -->
                        <div
                            class="d-flex justify-content-end gap-3 pt-3 border-top">
                            <button type="reset"
                                class="btn btn-light profile-action-btn px-4 py-2 rounded-pill fw-semibold text-muted">Cancel</button>
                            <button type="submit"
                                class="btn btn-primary profile-action-btn px-4 py-2 rounded-pill fw-semibold shadow-sm">Save
                                Changes</button>
                        </div>

                    </div>
                </div>

            </div>
        </form>

    </div>
</div>
