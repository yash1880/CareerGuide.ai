<%- include('partials/header') %>
    <%- include('partials/sidebar') %>
    <div class="sidebar-page-content">
    <main class="container-fluid py-4 px-4">
        <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4 app-page-heading">
            <div>
                <h2 class="fw-bold text-dark mb-1"><i class="ri-graduation-cap-line text-primary me-2"></i>Internship Opportunities</h2>
                <p class="text-muted mb-0">Explore available internships and track the opportunities you apply to.</p>
            </div>
            <span class="badge bg-primary rounded-pill px-3 py-2"><%= internships.length %> opportunities</span>
        </div>
        <div id="applicationMessage" class="alert d-none" role="status" aria-live="polite"></div>
        <% if (internships.length) { %>
            <div class="row g-4">
                <% internships.forEach((internship) => { %>
                    <div class="col-lg-4 col-md-6">
                        <article class="card border-0 shadow-sm rounded-4 p-4 h-100">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div class="bg-light p-3 rounded-4 text-primary"><i class="ri-building-line fs-4"></i></div>
                                <span class="badge bg-light text-dark border">Internship</span>
                            </div>
                            <h5 class="fw-bold mb-1"><%= internship.title %></h5>
                            <p class="text-primary fw-semibold mb-3"><%= internship.company %></p>
                            <p class="text-muted small flex-grow-1"><%= internship.description %></p>
                            <div class="small text-muted mb-3">
                                <div><i class="ri-map-pin-line me-1"></i><%= internship.location %></div>
                                <div class="mt-1"><i class="ri-time-line me-1"></i><%= internship.duration || 'Duration not specified' %> · <%= internship.stipend || 'Stipend not specified' %></div>
                                <% if (internship.postedDate) { %>
                                    <div class="mt-1"><i class="ri-calendar-line me-1"></i>Posted <%= internship.postedDate %></div>
                                <% } %>
                            </div>
                            <button class="btn btn-primary rounded-pill track-application"
                                    data-id="<%= internship._id %>"
                                    data-type="<%= internship.trackerType || 'Internship' %>">Track application</button>
                        </article>
                    </div>
                <% }) %>
            </div>
        <% } else { %>
            <div class="card border-0 shadow-sm rounded-4 text-center p-5">
                <i class="ri-search-eye-line fs-1 text-primary"></i>
                <h5 class="fw-bold mt-2">No internships available right now</h5>
                <p class="text-muted mb-0">Please check back later for new opportunities.</p>
            </div>
        <% } %>
    </main>
    <%- include('partials/footer') %>
    </div>
    <script>
        document.querySelectorAll('.track-application').forEach((button) => {
            button.addEventListener('click', async () => {
                button.disabled = true;
                const message = document.getElementById('applicationMessage');
                try {
                    const response = await fetch('/applications/api/apply', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            jobOrInternshipId: button.dataset.id,
                            type: button.dataset.type
                        })
                    });
                    const result = await response.json();
                    message.textContent = result.message || 'Unable to track this application.';
                    message.className = `alert ${response.ok || response.status === 409 ? 'alert-success' : 'alert-warning'}`;
                    if (response.ok || response.status === 409) button.textContent = 'Application tracked';
                } catch (error) {
                    message.textContent = 'Could not reach the server. Please try again.';
                    message.className = 'alert alert-danger';
                } finally {
                    message.classList.remove('d-none');
                    button.disabled = false;
                }
            });
        });
    </script>
</body>