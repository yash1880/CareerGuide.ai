
<% const sidebarPath = typeof path === 'string' ? path : ''; %>
<% const sidebarUser = typeof user !== 'undefined' ? user : null; %>
<button id="sidebarMenuToggle" class="btn btn-primary rounded-circle shadow d-lg-none"
        type="button" aria-label="Open navigation menu" aria-controls="appSidebar"
        aria-expanded="false">
    <i class="ri-menu-line fs-5" aria-hidden="true"></i>
</button>
<div id="sidebarBackdrop" class="sidebar-backdrop d-lg-none" hidden></div>
<!-- FIXED SIDEBAR -->
<div
    id="appSidebar"
    class="d-flex flex-column flex-shrink-0 p-3 bg-white border-end vh-100 position-fixed shadow-sm"
    style="width: 280px; top: 0; left: 0; z-index: 1040; overflow: hidden;">
    <a href="/"
        class="d-flex align-items-center mb-3 mb-md-0 me-md-auto text-dark text-decoration-none px-2 pt-2">
        <div
            class="bg-primary text-white p-2 rounded-3 d-flex align-items-center justify-content-center shadow-sm me-2"
            style="width: 34px; height: 34px;">
            <i class="ri-robot-2-fill fs-6"></i>
        </div>
        <span class="fs-5 fw-bold tracking-tight">CareerGuide<span
                class="text-primary">.ai</span></span>
    </a>
    <hr class="my-3 text-muted">

    <!-- Sidebar Navigation Links -->
    <ul class="nav nav-pills flex-column gap-1 sidebar-navigation">
        <li class="nav-item">
            <a href="/dashboard"
                class="nav-link sidebar-nav-link fw-semibold rounded-3 py-2 px-3 <%= sidebarPath === '/dashboard' ? 'active bg-primary text-white' : 'text-dark' %>"
                <% if (sidebarPath === '/dashboard') { %>aria-current="page"<% } %>>
                <i class="ri-dashboard-3-line fs-5 sidebar-nav-icon"></i><span class="sidebar-nav-label">Dashboard Overview</span>
            </a>
        </li>
        <li>
            <a href="/ai/mock-interview"
                class="nav-link sidebar-nav-link text-dark fw-semibold rounded-3 py-2 px-3 custom-sidebar-link <%= sidebarPath === '/ai/mock-interview' ? 'active bg-primary text-white' : '' %>"
                <% if (sidebarPath === '/ai/mock-interview') { %>aria-current="page"<% } %>>
                <i class="ri-question-answer-line fs-5 sidebar-nav-icon"></i><span class="sidebar-nav-label">Mock Interview</span>
            </a>
        </li>
        <li>
            <a href="/ai/mock-interview/tracker"
                class="nav-link sidebar-nav-link text-dark fw-semibold rounded-3 py-2 px-3 custom-sidebar-link <%= sidebarPath === '/ai/mock-interview/tracker' ? 'active bg-primary text-white' : '' %>"
                <% if (sidebarPath === '/ai/mock-interview/tracker') { %>aria-current="page"<% } %>>
                <i class="ri-line-chart-line fs-5 sidebar-nav-icon"></i><span class="sidebar-nav-label">Interview Improvement Tracker</span>
            </a>
        </li>
        <li class="nav-item">
            <a href="/users/profile"
                class="nav-link sidebar-nav-link fw-semibold rounded-3 py-2 px-3 <%= sidebarPath === '/users/profile' ? 'active bg-primary text-white' : 'text-dark' %>"
                <% if (sidebarPath === '/users/profile') { %>aria-current="page"<% } %>>
                <i class="ri-user-settings-line fs-5 sidebar-nav-icon"></i><span class="sidebar-nav-label">Profile Settings</span>
            </a>
        </li>
        <li>
            <a href="/jobs"
                class="nav-link sidebar-nav-link text-dark fw-semibold rounded-3 py-2 px-3 custom-sidebar-link <%= sidebarPath === '/jobs' ? 'active bg-primary text-white' : '' %>"
                <% if (sidebarPath === '/jobs') { %>aria-current="page"<% } %>>
                <i class="ri-briefcase-4-line fs-5 sidebar-nav-icon"></i><span class="sidebar-nav-label">Explore Jobs</span>
            </a>
        </li>
        <li>
            <a href="/internships"
                class="nav-link sidebar-nav-link text-dark fw-semibold rounded-3 py-2 px-3 custom-sidebar-link <%= sidebarPath === '/internships' ? 'active bg-primary text-white' : '' %>"
                <% if (sidebarPath === '/internships') { %>aria-current="page"<% } %>>
                <i class="ri-graduation-cap-line fs-5 sidebar-nav-icon"></i><span class="sidebar-nav-label">Internships</span>
            </a>
        </li>
        <li>
            <a href="/careers"
                class="nav-link sidebar-nav-link text-dark fw-semibold rounded-3 py-2 px-3 custom-sidebar-link <%= sidebarPath === '/careers' ? 'active bg-primary text-white' : '' %>"
                <% if (sidebarPath === '/careers') { %>aria-current="page"<% } %>>
                <i class="ri-compass-3-line fs-5 sidebar-nav-icon"></i><span class="sidebar-nav-label">Career Paths</span>
            </a>
        </li>
        <li class="nav-item">
            <a
                class="nav-link sidebar-nav-link text-dark fw-semibold rounded-3 py-2 px-3 custom-sidebar-link <%= sidebarPath === '/resume-ats' ? 'active bg-primary text-white' : '' %>"
                href="/resume-ats" <% if (sidebarPath === '/resume-ats') { %>aria-current="page"<% } %>>
                <i class="ri-file-text-line fs-5 sidebar-nav-icon"></i><span class="sidebar-nav-label">ATS Checker</span>
            </a>
        </li>
        <li>
            <a href="/roadmap"
                class="nav-link sidebar-nav-link text-dark fw-semibold rounded-3 py-2 px-3 custom-sidebar-link <%= sidebarPath === '/roadmap' ? 'active bg-primary text-white' : '' %>"
                <% if (sidebarPath === '/roadmap') { %>aria-current="page"<% } %>>
                <i class="ri-road-map-line fs-5 sidebar-nav-icon"></i><span class="sidebar-nav-label">Career Roadmaps</span>
            </a>
        </li>
        <li>
            <a href="/skills"
                class="nav-link sidebar-nav-link text-dark fw-semibold rounded-3 py-2 px-3 custom-sidebar-link <%= sidebarPath === '/skills' ? 'active bg-primary text-white' : '' %>"
                <% if (sidebarPath === '/skills') { %>aria-current="page"<% } %>>
                <i class="ri-bar-chart-box-line fs-5 sidebar-nav-icon"></i><span class="sidebar-nav-label">Skill Gap Analyzer</span>
            </a>
        </li>
        <li>
            <a href="/ai/counselor"
                class="nav-link sidebar-nav-link text-dark fw-semibold rounded-3 py-2 px-3 custom-sidebar-link <%= sidebarPath === '/ai/counselor' ? 'active bg-primary text-white' : '' %>"
                <% if (sidebarPath === '/ai/counselor') { %>aria-current="page"<% } %>>
                <i class="ri-robot-2-line fs-5 sidebar-nav-icon"></i><span class="sidebar-nav-label">AI Career Counselor</span>
            </a>
        </li>
        <li>
            <a href="/applications"
                class="nav-link sidebar-nav-link text-dark fw-semibold rounded-3 py-2 px-3 custom-sidebar-link <%= sidebarPath === '/applications' ? 'active bg-primary text-white' : '' %>"
                <% if (sidebarPath === '/applications') { %>aria-current="page"<% } %>>
                <i class="ri-file-list-3-line fs-5 sidebar-nav-icon"></i><span class="sidebar-nav-label">My Applications</span>
            </a>
        </li>
    </ul>
    <hr class="text-muted my-2">
    <div class="dropdown dropup sidebar-user-footer px-2 py-2">
        <a href="#"
            class="d-flex align-items-center text-dark text-decoration-none dropdown-toggle"
            id="sidebarUserDropdown" data-bs-toggle="dropdown"
            aria-expanded="false">
            <% if (sidebarUser && sidebarUser.profileImage) { %>
            <img src="<%= sidebarUser.profileImage %>" alt="avatar" width="36"
                height="36" class="rounded-circle me-2 object-fit-cover">
            <% } else { %>
            <div
                class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold me-2"
                style="width: 36px; height: 36px;">
                <%= (sidebarUser && sidebarUser.name) ? sidebarUser.name.charAt(0).toUpperCase() : 'U' %>
            </div>
            <% } %>
            <div class="overflow-hidden">
                <strong class="d-block text-truncate small"><%= (sidebarUser && sidebarUser.name) ? sidebarUser.name : 'Account' %></strong>
                <span class="text-muted" style="font-size: 11px;">Account settings</span>
            </div>
        </a>
        <ul class="dropdown-menu shadow border-0 rounded-4 mt-2">
            <li><a class="dropdown-item py-2" href="/users/profile"><i class="ri-user-settings-line me-2 text-primary"></i>Profile Settings</a></li>
            <li><hr class="dropdown-divider"></li>
            <li><a class="dropdown-item py-2 text-danger" href="/auth/logout"><i class="ri-logout-box-line me-2"></i>Sign out</a></li>
        </ul>
    </div>

    <style>
        #sidebarMenuToggle {
            position: fixed;
            top: 0.75rem;
            left: 0.75rem;
            z-index: 1051;
            width: 44px;
            height: 44px;
            padding: 0;
            align-items: center;
            justify-content: center;
        }

        .sidebar-backdrop {
            position: fixed;
            inset: 0;
            z-index: 1040;
            background: rgba(15, 23, 42, 0.45);
        }

        #appSidebar {
            overflow-y: auto;
            overscroll-behavior: contain;
            transition: transform 220ms ease;
        }

        .sidebar-page-content {
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            margin-left: 280px;
        }

        .sidebar-page-content > main {
            flex: 1 0 auto;
        }

        .sidebar-navigation .sidebar-nav-link {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            min-width: 0;
            transition: background-color 160ms ease, color 160ms ease, transform 160ms ease, box-shadow 160ms ease;
        }

        .sidebar-navigation {
            flex: 1 1 auto;
            min-height: 0;
            width: 100%;
            overflow-y: auto;
            overflow-x: hidden;
            overscroll-behavior: contain;
            scrollbar-width: thin;
        }

        .sidebar-navigation > li {
            flex: 0 0 auto;
            width: 100%;
        }

        .sidebar-user-footer {
            flex: 0 0 auto;
            position: relative;
            z-index: 1;
            background: #fff;
            padding-top: max(0.5rem, env(safe-area-inset-top));
        }

        .sidebar-navigation .sidebar-nav-icon {
            flex: 0 0 1.5rem;
            width: 1.5rem;
            text-align: center;
            color: var(--bs-primary);
        }

        .sidebar-navigation .sidebar-nav-label {
            flex: 1 1 auto;
            min-width: 0;
            line-height: 1.35;
        }

        .sidebar-navigation .sidebar-nav-link:hover {
            transform: translateX(2px);
            background-color: #f1f5f9;
        }

        .sidebar-navigation .sidebar-nav-link.active,
        .sidebar-navigation .sidebar-nav-link.active:hover {
            background-color: var(--bs-primary);
            color: #fff;
            box-shadow: 0 0.25rem 0.75rem rgba(13, 110, 253, 0.18);
        }

        .sidebar-navigation .sidebar-nav-link.active .sidebar-nav-icon {
            color: #fff;
        }

        .sidebar-navigation .sidebar-nav-link:focus-visible {
            outline: 3px solid rgba(13, 110, 253, 0.35);
            outline-offset: 2px;
        }

        @media (prefers-reduced-motion: reduce) {
            .sidebar-navigation .sidebar-nav-link {
                transition: none;
            }

            #appSidebar {
                transition: none;
            }
        }

        @media (max-width: 991.98px) {
            #appSidebar {
                width: min(280px, calc(100vw - 3rem)) !important;
                transform: translateX(-105%);
                visibility: hidden;
                transition: transform 220ms ease, visibility 220ms;
            }

            #appSidebar.is-open {
                transform: translateX(0);
                visibility: visible;
            }

            .sidebar-page-content {
                margin-left: 0;
                padding-top: 3.75rem;
            }

            body [style*="margin-left: 280px"] {
                margin-left: 0 !important;
                padding-top: 4.5rem !important;
            }

            body.sidebar-menu-open {
                overflow: hidden;
            }
        }
    </style>

    <script>
        (() => {
            const sidebar = document.getElementById('appSidebar');
            const toggle = document.getElementById('sidebarMenuToggle');
            const backdrop = document.getElementById('sidebarBackdrop');

            const setSidebarOpen = (isOpen) => {
                sidebar.classList.toggle('is-open', isOpen);
                backdrop.hidden = !isOpen;
                toggle.setAttribute('aria-expanded', String(isOpen));
                toggle.setAttribute('aria-label', isOpen ? 'Close navigation menu' : 'Open navigation menu');
                document.body.classList.toggle('sidebar-menu-open', isOpen);
            };

            toggle.addEventListener('click', () => {
                setSidebarOpen(!sidebar.classList.contains('is-open'));
            });
            backdrop.addEventListener('click', () => setSidebarOpen(false));
            sidebar.querySelectorAll('a').forEach((link) => {
                link.addEventListener('click', () => setSidebarOpen(false));
            });
            document.addEventListener('keydown', (event) => {
                if (event.key === 'Escape' && sidebar.classList.contains('is-open')) {
                    setSidebarOpen(false);
                    toggle.focus();
                }
            });
            window.addEventListener('resize', () => {
                if (window.innerWidth >= 992) setSidebarOpen(false);
            });
        })();
    </script>

</div>
